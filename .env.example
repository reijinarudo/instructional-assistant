# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore and must never be committed.

# Required. Create a key at https://platform.openai.com/api-keys
# If this is empty, the app asks for a key at startup and does not save it.
OPENAI_API_KEY=

# Realtime voice model. Check https://platform.openai.com/docs/models for current names.
REALTIME_MODEL=gpt-realtime-2.1

# Voice used for spoken replies (for example: verse, alloy, marin).
ASSISTANT_VOICE=verse

# Which file in profiles/ supplies the system instructions.
# automation = industrial automation training, academic = biology, A&P, statistics.
ASSISTANT_PROFILE=automation

# Text shown in the window title bar.
WINDOW_TITLE=Instructional Assistant
